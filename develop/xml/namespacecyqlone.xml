      <memberdef kind="function" id="namespacecyqlone_1a551aa703936f7c27064994d2e8353d07" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void cyqlone::reference_to_gradient</definition>
        <argsstring>(LinearOCPStorage &amp;ocp, std::span&lt; const real_t &gt; ref)</argsstring>
        <name>reference_to_gradient</name>
        <qualifiedname>cyqlone::reference_to_gradient</qualifiedname>
        <param>
          <type><ref refid="structcyqlone_1_1LinearOCPStorage" kindref="compound">LinearOCPStorage</ref> &amp;</type>
          <declname>ocp</declname>
        </param>
        <param>
          <type>std::span&lt; const real_t &gt;</type>
          <declname>ref</declname>
        </param>
        <briefdescription>
<para>Simply computes the gradient of the quadratic cost <formula id="0">$ J(x, u) = \sum_{j=1}^{N-1} \ell_j(x^j, u^j) + \ell_N(x^N) $</formula>, with  <formula id="1">$ \ell_j(x, u) = \tfrac12 \left\| \begin{pmatrix} x - x^j_\text{ref}
\\ u - u^j_\text{ref} \end{pmatrix} \right\|_{H_j}^2 $</formula>, with the Hessian <formula id="2">$ H_j = \begin{pmatrix} Q_j &amp; S_j^\top \\ S_j &amp; R_j \end{pmatrix} $</formula>.    </para>
        </briefdescription>
        <detaileddescription>
<para>Stores <formula id="3">$ \nabla J(0, 0) $</formula> to <computeroutput>qr</computeroutput>.    </para>
        </detaileddescription>
