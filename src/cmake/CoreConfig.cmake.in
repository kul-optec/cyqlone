@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(guanaqo COMPONENTS BLAS)
find_dependency(batmat)
if (@CYQLONE_WITH_MATIO@)
    find_dependency(matio)
endif()
if (@CYQLONE_WITH_ZLIB@)
    find_dependency(ZLIB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cyqloneCoreTargets.cmake")

check_required_components(cyqloneCore)
