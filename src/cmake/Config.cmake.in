@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(CYQLONE_AVAILABLE_COMPONENTS "Core")
# Always require "Core"
list(PREPEND cyqlone_FIND_COMPONENTS "Core")
if (cyqlone_FIND_REQUIRED)
    set(cyqlone_FIND_Core_REQUIRED True)
endif()

set(CYQLONE_FIND_QUIET_ARG)
if(cyqlone_FIND_QUIETLY)
    set(CYQLONE_FIND_QUIET_ARG QUIET)
endif()

foreach(COMP IN LISTS cyqlone_FIND_COMPONENTS)
    if (NOT COMP IN_LIST CYQLONE_AVAILABLE_COMPONENTS)
        set(cyqlone_NOT_FOUND_MESSAGE "Invalid component: ${COMP}")
        set(cyqlone_FOUND False)
        return()
    endif()
    set(CYQLONE_FIND_REQUIRED_ARG)
    if(cyqlone_FIND_REQUIRED_${COMP})
        set(CYQLONE_FIND_REQUIRED_ARG REQUIRED)
    endif()
    set(cyqlone${COMP}_ROOT ${CMAKE_CURRENT_LIST_DIR})
    find_package(cyqlone${COMP}
        ${CYQLONE_FIND_QUIET_ARG} ${CYQLONE_FIND_REQUIRED_ARG})
    if (NOT cyqlone${COMP}_FOUND AND cyqlone_FIND_REQUIRED_${COMP})
        set(cyqlone_NOT_FOUND_MESSAGE "Missing required components: ${COMP} (find_package(cyqlone${COMP}) failed)")
        set(cyqlone_FOUND False)
        return()
    endif()
    set(cyqlone_${COMP}_FOUND ${cyqlone${COMP}_FOUND})
endforeach()

if (cyqlone_Core_FOUND AND NOT _@PROJECT_NAME@_PRINTED AND "Core" IN_LIST cyqlone_FIND_COMPONENTS)
    get_target_property(CYQLONE_CONFIGS cyqlone::cyqlone IMPORTED_CONFIGURATIONS)
    message(STATUS "Found @PROJECT_NAME@ @PROJECT_VERSION@: ${CMAKE_CURRENT_LIST_DIR} (available configs: ${CYQLONE_CONFIGS}, installed components: @CYQLONE_OPTIONAL_COMPONENTS@, installed targets: @CYQLONE_INSTALL_TARGETS@)")
    set(_@PROJECT_NAME@_PRINTED On CACHE INTERNAL "")
endif()

check_required_components(cyqlone)
